<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pulsewatch.api.common.service.impl.CommMapper">
    <insert id="setInsertLog" parameterType="com.pulsewatch.api.common.domain.LogVO">
        INSERT
            INTO
                pulsewatch.log
                    (
                    method,
                    uri,
                    query,
                    status,
                    reqBody,
                    resBody)
                VALUES(
                    #{method},
                    #{uri},
                    #{query},
                    #{status},
                    #{reqBody},
                    #{resBody})
    </insert>
</mapper>